# ─── Chế độ dữ liệu ─────────────────────────────────────────────────────────
# true  => đọc dữ liệu mẫu trong src/fixtures (không cần Google) — dùng để dev/demo
# false => đọc dữ liệu thật từ Google Sheets
USE_MOCK_DATA=true

# ─── Google Service Account ────────────────────────────────────────────────
# Tạo service account trong Google Cloud, bật Google Sheets API + Drive API,
# rồi chia sẻ Spreadsheet (quyền Editor) và folder ảnh (quyền Viewer) cho email này.
GOOGLE_SERVICE_ACCOUNT_EMAIL=svc-decor@your-project.iam.gserviceaccount.com
# Lưu ý: giữ nguyên \n trong chuỗi (escaped). Trên Vercel dán cả khối, một dòng.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ─── Spreadsheet & Drive ───────────────────────────────────────────────────
GOOGLE_SHEET_ID=                 # ID nằm trong URL Google Sheet
GOOGLE_DRIVE_FOLDER_ID=          # (tùy chọn) folder chứa ảnh sản phẩm

# ─── Tên các tab (đổi nếu bạn đặt tên khác) ────────────────────────────────
SHEET_TAB_PRODUCTS=Products
SHEET_TAB_COLLECTIONS=Collections
SHEET_TAB_CATEGORIES=Categories
SHEET_TAB_STYLES=Styles
SHEET_TAB_SETTINGS=Settings
SHEET_TAB_CLICKS=Clicks

# ─── Webhook revalidate (gần realtime) ─────────────────────────────────────
# Chuỗi ngẫu nhiên dài; phải khớp với REVALIDATE_SECRET trong Apps Script.
REVALIDATE_SECRET=

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
